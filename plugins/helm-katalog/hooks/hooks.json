{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(propose_.*|apply_plan|apply_plans|cancel_plan)",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_batch.py\" post", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(review_plan|apply_plan|read_sql)",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_batch.py\" pre", "timeout": 5 }
        ]
      }
    ]
  }
}
